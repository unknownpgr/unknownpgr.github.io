#!/bin/bash
# Rebuild the static site and (re)deploy the blog behind the reverse proxy.
set -euo pipefail
cd "$(dirname "$0")/.."

builder_image="unknownpgr-blog-builder:local"

docker build --target builder -t "$builder_image" .
mkdir -p public
docker run --rm \
  --user "$(id -u):$(id -g)" \
  --volume "$PWD/posts:/app/posts" \
  --volume "$PWD/public:/app/static" \
  "$builder_image"

docker compose up -d
echo "Done!"
